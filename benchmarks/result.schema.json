{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Maitham16/UR/benchmarks/result.schema.json",
  "title": "UR benchmark result",
  "type": "object",
  "required": [
    "schemaVersion",
    "template",
    "agent",
    "date",
    "benchmark",
    "runtime",
    "results",
    "reproduction"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "template": {
      "type": "boolean"
    },
    "agent": {
      "type": "object",
      "required": [
        "name",
        "version",
        "commit"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "dirty",
            "sha256",
            "files",
            "scope"
          ],
          "properties": {
            "dirty": {
              "type": "boolean"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "scope": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "date": {
      "type": "string"
    },
    "benchmark": {
      "type": "object",
      "required": [
        "name",
        "category",
        "taskCount"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "internal-regression",
            "terminal-coding",
            "provider-routing",
            "tool-use",
            "sandbox-safety",
            "swe-bench-lite",
            "terminal-bench",
            "aider-polyglot",
            "custom"
          ]
        },
        "taskCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "environment"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "required": [
            "platform",
            "arch",
            "node",
            "bun",
            "cwd"
          ],
          "properties": {
            "platform": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "node": {
              "type": "string"
            },
            "bun": {
              "type": [
                "string",
                "null"
              ]
            },
            "cwd": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "passRate",
        "taskResults",
        "failedTasks",
        "failureCategories",
        "wallTimeMs",
        "tokenUsage",
        "costUSD"
      ],
      "properties": {
        "passed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "passRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "taskResults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "category",
              "passed",
              "wallTimeMs",
              "failureCategory"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "wallTimeMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "failureCategory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "evaluationMode": {
                    "enum": [
                      "native-agent",
                      "offline-replay"
                    ]
                  },
                  "executableSha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "patchSha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "verificationSha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "completionClaim": {
                    "enum": [
                      "pass",
                      "fail",
                      "partial",
                      "unspecified"
                    ]
                  },
                  "falseCompletion": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "exitCode": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "testPassed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "configuration": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "provenance": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "toolCalls": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "failedToolCalls": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "turns": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "humanInterventions": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "rollbacks": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "costUSD": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "inputTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "outputTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "failedTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category",
              "failureCategory",
              "failedChecks"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "failureCategory": {
                "type": "string"
              },
              "failedChecks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "failureCategories": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "wallTimeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokenUsage": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "inputTokens",
            "outputTokens",
            "totalTokens"
          ],
          "properties": {
            "inputTokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "outputTokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "totalTokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "costUSD": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "completionClaims": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "falseCompletions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "falseCompletionRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "required": [
        "command",
        "inputReport",
        "generatedBy"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "inputReport": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedBy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
